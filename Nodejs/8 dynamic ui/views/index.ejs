<%- include('partials/head') %>
</head>
<body class="min-h-screen bg-linear-to-br from-blue-100 to-gray-100 font-sans">
  <%- include('partials/nav') %>

  <main>
    <div class="container mx-auto px-4 py-14">
      <h1 class="text-5xl font-extrabold text-blue-700 mb-7 text-center drop-shadow-lg">Welcome to Hamara airbnb</h1>
      <div class="flex justify-center">
        <ul class="w-full max-w-2xl grid grid-cols-1 gap-6">
          <% if (!homes.length) { %>
            <li class="bg-white border-2 border-dashed border-blue-200 shadow-inner rounded-xl px-8 py-10 text-center text-gray-400 text-xl font-medium">
              No homes available yet. Be the first to add your home!
            </li>
          <% } %>
          <% homes.forEach(home => { %>
            <li class="bg-white shadow-xl rounded-xl px-8 py-6 flex items-center gap-4 hover:ring-2 hover:ring-blue-200 hover:scale-102 transform transition cursor-pointer">
              <span class="text-xl font-semibold text-gray-800 tracking-tight flex-1"><%= home.houseName %></span>
              <!-- You may want to put more details or a button here -->
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </main>
</body>
</html>